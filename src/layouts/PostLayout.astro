---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  project: string;
}

const { title, date, project } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span class="separator">&middot;</span>
        <a href={`/projects/${project}`}>{project}</a>
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
    <nav class="post-nav">
      <a href="/blog">&larr; All posts</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 2rem;
  }

  .post-meta {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .separator {
    margin: 0 0.5rem;
  }

  .post-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
