---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const projectNames = [...new Set(allPosts.map((p) => p.data.project))];

  return projectNames.map((name) => ({
    params: { slug: name },
    props: {
      name,
      posts: allPosts
        .filter((p) => p.data.project === name)
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { name, posts } = Astro.props;
const displayName = name.replace(/-/g, ' ');

const timelineItems = posts.map((post: any) => ({
  slug: post.id,
  title: post.data.title,
  date: post.data.date,
  summary: post.data.summary,
}));
---

<BaseLayout title={displayName}>
  <header class="project-header">
    <h1>{displayName}</h1>
    <p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>

  <section class="timeline-section">
    <h2>Progress</h2>
    <Timeline items={timelineItems} />
  </section>

  <nav class="back-link">
    <a href="/projects">&larr; All projects</a>
  </nav>
</BaseLayout>

<style>
  .project-header {
    margin-bottom: 2rem;
  }

  .project-header h1 {
    text-transform: capitalize;
  }

  .meta {
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .timeline-section {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .timeline-section h2 {
    margin-bottom: 1.5rem;
  }

  .back-link {
    margin-top: 2rem;
  }
</style>
