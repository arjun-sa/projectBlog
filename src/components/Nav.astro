---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
];
---

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="logo">Arjun's Ideas</a>
    <ul>
      {
        links.map(({ href, label }) => (
          <li>
            <a href={href} class:list={{ active: pathname === href || (href !== '/' && pathname.startsWith(href)) }}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
  }

  .logo:hover {
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
  }

  ul a {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  ul a:hover,
  ul a.active {
    color: var(--text);
    text-decoration: none;
  }
</style>
